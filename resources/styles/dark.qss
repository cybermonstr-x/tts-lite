/* Modern Dark Theme QSS - v2.0 */
QMainWindow {
    background-color: #1a1b26;
}

QWidget {
    background-color: #1a1b26;
    color: #c0caf5;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

/* Buttons */
QPushButton {
    background-color: #3b4261;
    color: #c0caf5;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 80px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #414868;
}

QPushButton:pressed {
    background-color: #292e42;
}

QPushButton:disabled {
    background-color: #24283b;
    color: #565f89;
}

/* Play/Pause button */
QPushButton#playButton {
    background-color: #9ece6a;
    color: #1a1b26;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#playButton:hover {
    background-color: #73daca;
}

QPushButton#stopButton {
    background-color: #f7768e;
    color: #1a1b26;
}

QPushButton#stopButton:hover {
    background-color: #ff9e64;
}

/* Text Editor */
QPlainTextEdit {
    background-color: #24283b;
    color: #c0caf5;
    border: 2px solid #3b4261;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #3b4261;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11pt;
    line-height: 1.5;
}

QPlainTextEdit:focus {
    border-color: #7aa2f7;
}

/* Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #3b4261;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #7aa2f7;
    border: none;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #89b4fa;
}

QSlider::sub-page:horizontal {
    background: #7aa2f7;
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #c0caf5;
}

QLabel#headerLabel {
    font-size: 16pt;
    font-weight: bold;
    color: #7aa2f7;
    padding: 8px;
}

/* ComboBox */
QComboBox {
    background-color: #3b4261;
    color: #c0caf5;
    border: 2px solid #3b4261;
    border-radius: 8px;
    padding: 8px 14px;
    min-width: 150px;
}

QComboBox:hover {
    border-color: #7aa2f7;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #c0caf5;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #24283b;
    color: #c0caf5;
    selection-background-color: #3b4261;
    border: 2px solid #3b4261;
    border-radius: 4px;
    padding: 4px;
}

/* ProgressBar */
QProgressBar {
    border: none;
    border-radius: 6px;
    text-align: center;
    background-color: #3b4261;
    height: 12px;
    color: #c0caf5;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #7aa2f7;
    border-radius: 6px;
}

/* GroupBox */
QGroupBox {
    border: 2px solid #3b4261;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: bold;
    color: #7aa2f7;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #7aa2f7;
}

/* Menu Bar */
QMenuBar {
    background-color: #1a1b26;
    color: #c0caf5;
    border-bottom: 1px solid #3b4261;
}

QMenuBar::item:selected {
    background-color: #3b4261;
    border-radius: 4px;
}

QMenu {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b4261;
}

QMenu::separator {
    height: 1px;
    background-color: #3b4261;
    margin: 4px 8px;
}

/* Status Bar */
QStatusBar {
    background-color: #7aa2f7;
    color: #1a1b26;
    font-weight: 500;
}

/* Scroll Bar */
QScrollBar:vertical {
    border: none;
    background-color: #1a1b26;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3b4261;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7aa2f7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #1a1b26;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3b4261;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7aa2f7;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tool Tips */
QToolTip {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px;
}

/* Splitter */
QSplitter::handle {
    background-color: #3b4261;
    width: 2px;
    margin: 0 4px;
}

QSplitter::handle:hover {
    background-color: #7aa2f7;
}
