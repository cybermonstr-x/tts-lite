/* Modern Light Theme QSS - v2.0 */
QMainWindow {
    background-color: #f0f0f5;
}

QWidget {
    background-color: #f0f0f5;
    color: #1a1b26;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

/* Buttons */
QPushButton {
    background-color: #7aa2f7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 80px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #5d8bf4;
}

QPushButton:pressed {
    background-color: #4a7be0;
}

QPushButton:disabled {
    background-color: #e0e0e8;
    color: #a0a0b0;
}

/* Play/Pause button */
QPushButton#playButton {
    background-color: #4caf50;
    color: #ffffff;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#playButton:hover {
    background-color: #43a047;
}

QPushButton#stopButton {
    background-color: #f44336;
    color: #ffffff;
}

QPushButton#stopButton:hover {
    background-color: #e53935;
}

/* Text Editor */
QPlainTextEdit {
    background-color: #ffffff;
    color: #1a1b26;
    border: 2px solid #d0d0e0;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #7aa2f7;
    selection-color: #ffffff;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11pt;
    line-height: 1.5;
}

QPlainTextEdit:focus {
    border-color: #7aa2f7;
}

/* Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #d0d0e0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #7aa2f7;
    border: none;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #5d8bf4;
}

QSlider::sub-page:horizontal {
    background: #7aa2f7;
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #1a1b26;
}

QLabel#headerLabel {
    font-size: 16pt;
    font-weight: bold;
    color: #3b5998;
    padding: 8px;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    color: #1a1b26;
    border: 2px solid #d0d0e0;
    border-radius: 8px;
    padding: 8px 14px;
    min-width: 150px;
}

QComboBox:hover {
    border-color: #7aa2f7;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #1a1b26;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1b26;
    selection-background-color: #e8f0fe;
    border: 1px solid #d0d0e0;
    border-radius: 4px;
    padding: 4px;
}

/* ProgressBar */
QProgressBar {
    border: none;
    border-radius: 6px;
    text-align: center;
    background-color: #e0e0e8;
    height: 12px;
    color: #1a1b26;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #7aa2f7;
    border-radius: 6px;
}

/* GroupBox */
QGroupBox {
    border: 2px solid #d0d0e0;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: bold;
    color: #3b5998;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #3b5998;
}

/* Menu Bar */
QMenuBar {
    background-color: #f0f0f5;
    color: #1a1b26;
    border-bottom: 1px solid #d0d0e0;
}

QMenuBar::item:selected {
    background-color: #e8f0fe;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    color: #1a1b26;
    border: 1px solid #d0d0e0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e8f0fe;
}

QMenu::separator {
    height: 1px;
    background-color: #d0d0e0;
    margin: 4px 8px;
}

/* Status Bar */
QStatusBar {
    background-color: #7aa2f7;
    color: #ffffff;
    font-weight: 500;
}

/* Scroll Bar */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f5;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #c0c0d0;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7aa2f7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f5;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0d0;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7aa2f7;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tool Tips */
QToolTip {
    background-color: #ffffff;
    color: #1a1b26;
    border: 1px solid #d0d0e0;
    border-radius: 6px;
    padding: 6px;
}

/* Splitter */
QSplitter::handle {
    background-color: #d0d0e0;
    width: 2px;
    margin: 0 4px;
}

QSplitter::handle:hover {
    background-color: #7aa2f7;
}
